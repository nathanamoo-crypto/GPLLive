# Copy this file to application-local.yml (already gitignored) and fill in real values.
# Then run with the "local" Spring profile active, e.g.:
#   IntelliJ Run Configuration -> Active profiles: local
#   or: SPRING_PROFILES_ACTIVE=local ./mvnw spring-boot:run
#   or just set these as environment variables directly and skip this file entirely.
spring:
  security:
    jwt:
      secret-key: REPLACE_WITH_A_NEW_LONG_RANDOM_BASE64_SECRET
  datasource:
    url: jdbc:postgresql://localhost:5432/fantasy_leadue
    username: REPLACE_WITH_YOUR_DB_USERNAME
    password: REPLACE_WITH_YOUR_DB_PASSWORD
