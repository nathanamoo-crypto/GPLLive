# Copy this file to .env.local (already gitignored via .env*.local) to point
# your app at a backend running on your own machine instead of the shared
# deployed one - handy while working on an in-progress backend change.
#
# Use your computer's LAN IP, not "localhost" - a physical phone on the same
# Wi-Fi can't resolve "localhost" as your dev machine. Find it with
# `ipconfig` (Windows) or `ifconfig`/`ipconfig getifaddr en0` (Mac).
EXPO_PUBLIC_API_HOST=http://192.168.1.100:8080

# "Continue with Google" - the Web application OAuth Client ID from Google
# Cloud Console (APIs & Services > Credentials). Must match the
# GOOGLE_WEB_CLIENT_ID set on the backend, or Google ID token verification
# there will reject every sign-in as wrong-audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
